#!/bin/env python

"""
    This script runs a various set of commands in a "smart" way to run recon.
    It has a big set of dependencies, but should work against a standard kali
    install.
"""

import argparse
import os
import subprocess
import shutil
import shlex
from typing import Optional, Dict, Any

class ShellCommandRunner:
    """
    A class for safely running shell commands and checking for program existence.

    It uses the modern subprocess.run() API for execution and provides structured
    results for easy parsing and decision-making in Python.
    """

    def __init__(self):
        """
        Initializes the ShellCommandRunner.
        """

    def _get_program_name(self, command: str) -> str:
        """
        Internal helper to reliably extract the program name from a command string.
        Uses shlex.split to handle quoted arguments correctly.
        """
        try:
            parts = shlex.split(command)
            return parts[0]
        except ValueError:
            return command.split()[0] if command.strip() else ""
        except IndexError:
            return ""

    def is_callable(self, command: str) -> bool:
        """
        Checks if the main program specified in the command string is executable
        and can be found in the system's PATH environment variable.

        Args:
            command: The full command string (e.g., 'ls -la /tmp').

        Returns:
            True if the program is found and executable, False otherwise.
        """
        program_name = self._get_program_name(command)
        if not program_name:
            return False

        return shutil.which(program_name) is not None

    def execute_command(self, command: str, timeout: int = 15) -> Dict[str, Any]:
        """
        Safely executes a shell command and captures its output and status.

        Execution is performed without using shell=True for security.

        Args:
            command: The full command string (e.g., 'grep "error" logfile.txt').
            timeout: Maximum time (in seconds) to wait for the command to finish.

        Returns:
            A dictionary containing:
            - 'success': bool (True if execution succeeded and exit code was 0)
            - 'exit_code': int (The return code of the command)
            - 'stdout': str (Standard output)
            - 'stderr': str (Standard error)
            - 'error': Optional[str] (Python exception description if one occurred)
        """
        # Default failure result
        result = {
            'success': False,
            'exit_code': -1,
            'stdout': '',
            'stderr': '',
            'error': None
        }

        program_name = self._get_program_name(command)

        if not self.is_callable(command):
            result['error'] = f"Program '{program_name}' not found or is not callable on the system PATH."
            return result

        try:
            args = shlex.split(command)

            proc = subprocess.run(
                args,
                capture_output=True,
                text=True,
                check=False,
                timeout=timeout
            )

            result['exit_code'] = proc.returncode
            result['stdout'] = proc.stdout.strip()
            result['stderr'] = proc.stderr.strip()
            result['success'] = proc.returncode == 0

        except subprocess.TimeoutExpired:
            result['error'] = f"Command timed out after {timeout} seconds."
        except OSError as e:
            result['error'] = f"OS Error during execution: {e}"
        except Exception as e:
            result['error'] = f"An unexpected error occurred: {e}"

        return result

def shexec(command):

    runner = ShellCommandRunner()
    res = runner.execute_command(command)

    if not res['success']:
        print(res['stderr'])
        os.exit(1)

    print(f'>>> {command} <<<')
    print(res['stdout'] + '\n--------------------------------------------------------------------------------------------\n\n')
    return res['stdout']


