#!/bin/env python3

"""
HTB recon script — uses yellow to set up the environment and run an initial
port scan + web enum, then dispatches service-specific Kali tools based on
what's actually open.
"""

import argparse
import json
import shlex
import shutil
import subprocess
import sys
from pathlib import Path


# ---------------------------------------------------------------------------
# Execution helpers
# ---------------------------------------------------------------------------

def die(msg):
    print(f"[!] {msg}", file=sys.stderr)
    sys.exit(1)


def run(command, check=True):
    """Stream a command's output live and return it. Dies on failure if check=True."""
    print(f"\n[>] {command}")
    proc = subprocess.Popen(
        shlex.split(command),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    buf = []
    for line in proc.stdout:
        print(line, end="", flush=True)
        buf.append(line)
    proc.wait()
    print()
    if check and proc.returncode != 0:
        die(f"command failed (exit {proc.returncode}): {command}")
    return "".join(buf)


def try_run(command):
    """Like run() but never dies — errors are printed and execution continues."""
    return run(command, check=False)


# ---------------------------------------------------------------------------
# Port scan result parsing
# ---------------------------------------------------------------------------

def parse_portscan(target):
    """
    Yellow writes portscan.json to {target}/{target}/portscan.json because
    ScanOpts.scanPath and ScanOpts.domain are both set to the -d value,
    and runPortScan uses scanPath + "/" + domain as the output directory.
    """
    candidates = [
        Path(target) / target / "portscan.json",
        Path(target) / "portscan.json",
    ]
    for path in candidates:
        if path.exists():
            with open(path) as f:
                data = json.load(f)
            return data.get("open_ports", [])
    print("[!] portscan.json not found — skipping service-specific scans")
    return []


# ---------------------------------------------------------------------------
# Service-specific handlers
# ---------------------------------------------------------------------------

def nmap_targeted(target, ports, outdir):
    port_str = ",".join(str(p["port"]) for p in ports)
    try_run(f"nmap -sV -sC -p {port_str} -oN {outdir}/nmap-services {target}")


def handle_ftp(target, outdir):
    try_run(f"nmap -sV -sC -p 21 --script ftp-anon,ftp-bounce,ftp-syst -oN {outdir}/nmap-ftp.txt {target}")


def handle_ssh(target, outdir):
    try_run(f"nmap -sV -sC -p 22 --script ssh-hostkey,ssh-auth-methods -oN {outdir}/nmap-ssh.txt {target}")


def handle_smtp(target, outdir):
    try_run(f"nmap -sV -sC -p 25 --script smtp-enum-users,smtp-commands -oN {outdir}/nmap-smtp.txt {target}")


def handle_dns(target, outdir):
    if shutil.which("dig"):
        try_run(f"dig any {target} @{target}")
        try_run(f"dig axfr {target} @{target}")
    try_run(f"nmap -sV -sC -p 53 --script dns-zone-transfer -oN {outdir}/nmap-dns.txt {target}")


def handle_smb(target, outdir):
    if shutil.which("enum4linux-ng"):
        try_run(f"enum4linux-ng -A {target} -oJ {outdir}/enum4linux")
    elif shutil.which("enum4linux"):
        try_run(f"enum4linux -a {target}")
    if shutil.which("smbclient"):
        try_run(f"smbclient -L //{target}/ -N")
    netexec = shutil.which("nxc") or shutil.which("crackmapexec")
    if netexec:
        try_run(f"{netexec} smb {target}")


def handle_ldap(target, outdir):
    try_run(f"nmap -sV -sC -p 389 --script ldap-rootdse -oN {outdir}/nmap-ldap.txt {target}")
    if shutil.which("ldapsearch"):
        try_run(f"ldapsearch -x -H ldap://{target} -b '' -s base namingContexts")


def handle_web(target, port, outdir):
    scheme = "https" if port in (443, 8443) else "http"
    url = f"{scheme}://{target}:{port}"
    if shutil.which("nikto"):
        try_run(f"nikto -h {url} -o {outdir}/nikto-{port}.txt")
    wl = next(
        (w for w in [
            "/usr/share/wordlists/seclists/Discovery/Web-Content/raft-medium-directories.txt",
            "/usr/share/wordlists/seclists/Discovery/Web-Content/common.txt",
            "/usr/share/wordlists/dirb/common.txt",
        ] if Path(w).exists()),
        None,
    )
    if wl:
        if shutil.which("feroxbuster"):
            try_run(f"feroxbuster -u {url} -w {wl} -o {outdir}/ferox-{port}.txt -q")
        elif shutil.which("gobuster"):
            try_run(f"gobuster dir -u {url} -w {wl} -o {outdir}/gobuster-{port}.txt -q")


def handle_mysql(target, outdir):
    try_run(f"nmap -sV -sC -p 3306 --script mysql-info,mysql-empty-password -oN {outdir}/nmap-mysql.txt {target}")


def handle_mssql(target, outdir):
    try_run(f"nmap -sV -sC -p 1433 --script ms-sql-info,ms-sql-empty-password -oN {outdir}/nmap-mssql.txt {target}")


def handle_rdp(target, outdir):
    try_run(f"nmap -sV -sC -p 3389 --script rdp-enum-encryption -oN {outdir}/nmap-rdp.txt {target}")


def handle_winrm(target, outdir):
    netexec = shutil.which("nxc") or shutil.which("crackmapexec")
    if netexec:
        try_run(f"{netexec} winrm {target}")


def handle_vnc(target, outdir):
    try_run(f"nmap -sV -sC -p 5900 --script vnc-info,realvnc-auth-bypass -oN {outdir}/nmap-vnc.txt {target}")


# ---------------------------------------------------------------------------
# Port → handler mapping
# ---------------------------------------------------------------------------

SERVICE_MAP = {
    21:   ("FTP",    handle_ftp),
    22:   ("SSH",    handle_ssh),
    25:   ("SMTP",   handle_smtp),
    53:   ("DNS",    handle_dns),
    80:   ("HTTP",   lambda t, o: handle_web(t, 80, o)),
    139:  ("SMB",    handle_smb),
    389:  ("LDAP",   handle_ldap),
    443:  ("HTTPS",  lambda t, o: handle_web(t, 443, o)),
    445:  ("SMB",    handle_smb),
    1433: ("MSSQL",  handle_mssql),
    3306: ("MySQL",  handle_mysql),
    3389: ("RDP",    handle_rdp),
    5900: ("VNC",    handle_vnc),
    5985: ("WinRM",  handle_winrm),
    5986: ("WinRM",  handle_winrm),
    8080: ("HTTP",   lambda t, o: handle_web(t, 8080, o)),
    8443: ("HTTPS",  lambda t, o: handle_web(t, 8443, o)),
    8888: ("HTTP",   lambda t, o: handle_web(t, 8888, o)),
}

# Ports that share the same handler and should only run once
DEDUP_GROUPS = [
    {139, 445},   # SMB
    {5985, 5986}, # WinRM
]


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="HTB recon — yellow setup + port scan + service-specific tools"
    )
    parser.add_argument("-t", "--target", required=True, help="target IP or hostname (e.g. 10.10.10.10)")
    parser.add_argument("-w", "--wordlist", help="custom wordlist for dir brute-forcing")
    parser.add_argument("-p", "--proxy", help="proxy URL")
    parser.add_argument("-r", "--rate-limit", type=int, default=0, dest="rate_limit")
    parser.add_argument("-k", "--insecure", action="store_true", help="force HTTP / skip SSL")
    parser.add_argument("--osint", action="store_true", help="run yellow osint step (useful for domains, not bare IPs)")
    parser.add_argument("--ports", default="21,22,23,25,53,80,110,135,139,143,389,443,445,993,995,1433,1723,3306,3389,5900,5985,5986,8080,8443,8888",
                        help="ports for yellow --port-scan")
    args = parser.parse_args()

    target = args.target

    if not shutil.which("yellow"):
        die("yellow not found in PATH")
    if not shutil.which("nmap"):
        die("nmap not found in PATH")

    proxy_opt   = f"-p {args.proxy}"      if args.proxy      else ""
    rate_opt    = f"-r {args.rate_limit}" if args.rate_limit else ""
    insecure_opt = "-k"                   if args.insecure   else ""

    # 1. create directory structure
    run(f"yellow -d {target}")

    # 2. osint (optional — mostly useful when target is a real domain)
    if args.osint:
        try_run(f"yellow osint -d {target} {proxy_opt} {rate_opt}".strip())

    # 3. scan with yellow (port scan + web enum)
    run(
        " ".join(filter(None, [
            "yellow scan",
            f"-d {target}",
            "--port-scan",
            f"--ports {args.ports}",
            proxy_opt, rate_opt, insecure_opt,
        ]))
    )

    # 4. parse what yellow found
    open_ports = parse_portscan(target)
    if not open_ports:
        print("[*] no port scan results found — done")
        sys.exit(0)

    print(f"\n[+] open ports: {[p['port'] for p in open_ports]}")

    scans_dir = Path(target) / "scans"
    scans_dir.mkdir(parents=True, exist_ok=True)

    # 5. nmap targeted — full service + script detection on confirmed open ports
    nmap_targeted(target, open_ports, scans_dir)

    # 6. service-specific tools
    seen = set()
    for port_info in open_ports:
        port = port_info["port"]
        entry = SERVICE_MAP.get(port)
        if entry is None:
            continue

        # deduplicate ports that share a handler (SMB on 139+445, WinRM on 5985+5986)
        group_key = next((frozenset(g) for g in DEDUP_GROUPS if port in g), None)
        if group_key:
            if group_key in seen:
                continue
            seen.add(group_key)

        label, handler = entry
        print(f"\n[+] {label} on port {port} — launching tools")
        handler(target, scans_dir)

    print(f"\n[+] done. results in ./{target}/")
